# ====================================
# Micro-Store Arch: Variables de Entorno
# ====================================
# Copiar a .env: cp .env.example .env

# --- Supabase ---
# PUBLIC_SUPABASE_URL: URL para el NAVEGADOR → api.localhost (vía nginx → Kong, requiere entrada en hosts)
# SUPABASE_URL: URL interna Docker para SSR/server (Kong directo, sin pasar por nginx)
# Obtener ANON_KEY y SERVICE_ROLE_KEY ejecutando: supabase status
PUBLIC_SUPABASE_URL=http://api.localhost
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# --- Encriptación ---
# Clave de 64 caracteres hex para encriptar credenciales de pago en BD (nivel DB global)
ENCRYPTION_KEY=dev-64-char-key-not-for-production-use-only
# Clave inyectada por el Edge Function vía set_config por transacción (mínimo 32 chars).
# Debe coincidir con ENCRYPTION_KEY en dev. En producción usar: supabase secrets set PAYMENT_ENCRYPTION_KEY=<valor>
PAYMENT_ENCRYPTION_KEY=dev-64-char-key-not-for-production-use-only-local

# --- URLs Públicas ---
PUBLIC_STOREFRONT_URL=http://localhost
PUBLIC_CLIENT_HUB_URL=http://client.localhost
PUBLIC_VENDOR_ADMIN_URL=http://admin.localhost
PUBLIC_API_BASE=http://api.localhost

# --- CORS ---
# Lista de orígenes permitidos separados por coma (sin espacios)
# En producción usar los dominios reales de Cloudflare Pages
ALLOWED_ORIGINS=http://localhost,http://client.localhost,http://admin.localhost

# --- Pasarelas de Pago ---
# Stripe
STRIPE_SECRET_KEY=sk_test_...

# PayPal — usar 'production' en producción
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=...
PAYPAL_SECRET=...

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...

# Hey Banco — la CLABE se configura por el vendor en el panel de Configuración de Pagos
# No se almacena en .env; se guarda encriptada en la BD via manage-payment-gateways

# --- Email Transaccional (Resend) ---
# Obtener en https://resend.com/api-keys (Full Access)
# Sin esta clave las funciones send-order-email y send-shipping-email retornan 500.
RESEND_API_KEY=re_...
# Dirección FROM verificada en Resend. En local puede ser cualquier valor.
EMAIL_FROM=noreply@tienda.com
