---
import ClientHubLayout from '../../layouts/ClientHubLayout.astro';
---

<ClientHubLayout title="Mis Pedidos">
  <div class="orders-page" x-data="orderList()" x-init="init()">
    <header class="page-header">
      <h1>Mis Pedidos</h1>
      <p>Sigue el progreso de tus compras en tiempo real</p>
    </header>

    <template x-if="loading">
      <div class="loading-state">
        <div class="spinner"></div>
        <p>Cargando tus pedidos...</p>
      </div>
    </template>

    <template x-if="!loading && orders.length === 0">
      <div class="empty-state" x-transition>
        <div class="empty-icon">📦</div>
        <h2>Aún no tienes pedidos</h2>
        <p>Cuando realices una compra en la tienda, aparecerá aquí.</p>
        <a href="/" class="btn-primary">Explorar Tienda</a>
      </div>
    </template>

    <template x-if="!loading && orders.length > 0">
      <div class="orders-grid">
        <template x-for="order in orders" :key="order.id">
          <a :href="`/orders/${order.id}`" class="order-card" x-transition>
            <div class="order-card-header">
              <div class="order-meta">
                <span class="order-id" x-text="order.displayId"></span>
                <span class="order-date" x-text="formatDate(order.createdAt)"></span>
              </div>
              <span class="order-total" x-text="order.totalAmount"></span>
            </div>

            <div class="order-card-body">
              <div class="order-status-line">
                <span 
                  class="status-badge"
                  :class="'status--' + order.status"
                  x-text="getStatusLabel(order.status)"
                ></span>
                <template x-if="order.trackingId">
                  <span class="shipping-tag">🚚 <span x-text="order.carrier"></span></span>
                </template>
              </div>

              <div class="order-items-preview">
                <template x-for="(item, index) in order.items.slice(0, 2)" :key="item.id">
                  <span class="item-tag" x-text="item.productName"></span>
                </template>
                <template x-if="order.items.length > 2">
                  <span class="item-more" x-text="`+${order.items.length - 2} más`"></span>
                </template>
              </div>
            </div>
            
            <div class="order-card-footer">
              <span>Ver detalles del pedido</span>
              <span class="arrow">→</span>
            </div>
          </a>
        </template>
      </div>
    </template>
  </div>
</ClientHubLayout>

<script>
  import { loadCustomerOrders } from '../../lib/orders/order-client';

  window.orderList = () => ({
    orders: [],
    loading: true,

    async init() {
      await this.fetchOrders();
    },

    async fetchOrders() {
      this.loading = true;
      try {
        this.orders = await loadCustomerOrders();
      } catch (err) {
        console.error('Error loading orders:', err);
      } finally {
        this.loading = false;
      }
    },

    formatDate(dateStr) {
      return new Date(dateStr).toLocaleDateString('es-MX', {
        year: 'numeric', month: 'short', day: 'numeric'
      });
    },

    getStatusLabel(status) {
      const labels = {
        pending: 'Pendiente',
        paid: 'Pagado',
        in_production: 'En Producción',
        shipped: 'Enviado',
        delivered: 'Entregado',
        cancelled: 'Cancelado'
      };
      return labels[status] || status;
    }
  });
</script>

<style>
  .orders-page { padding: 2rem 0 5rem; }
  .page-header { margin-bottom: 3rem; }
  .page-header h1 { font-size: 2.5rem; font-weight: 800; color: #1e293b; margin-bottom: 0.5rem; }
  .page-header p { color: #64748b; font-size: 1.1rem; }

  .orders-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1.5rem; }

  .order-card { 
    background: white; 
    border: 1px solid #e2e8f0; 
    border-radius: 20px; 
    padding: 1.5rem; 
    text-decoration: none; 
    color: inherit;
    transition: all 0.2s;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .order-card:hover { transform: translateY(-4px); border-color: #4f46e5; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05); }

  .order-card-header { display: flex; justify-content: space-between; align-items: flex-start; }
  .order-meta { display: flex; flex-direction: column; gap: 0.25rem; }
  .order-id { font-weight: 800; color: #1e293b; font-size: 1.1rem; }
  .order-date { font-size: 0.8rem; color: #64748b; }
  .order-total { font-weight: 700; color: #4f46e5; font-size: 1.1rem; }

  .order-status-line { display: flex; align-items: center; gap: 1rem; }
  .status-badge { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; padding: 0.25rem 0.75rem; border-radius: 8px; }
  .status--pending { background: #fff7ed; color: #9a3412; }
  .status--paid { background: #f0f9ff; color: #075985; }
  .status--in_production { background: #f5f3ff; color: #5b21b6; }
  .status--shipped { background: #f0fdf4; color: #166534; }
  .status--delivered { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
  .status--cancelled { background: #fef2f2; color: #991b1b; }

  .shipping-tag { font-size: 0.8rem; color: #64748b; font-weight: 500; }

  .order-items-preview { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .item-tag { background: #f1f5f9; padding: 0.2rem 0.6rem; border-radius: 6px; font-size: 0.75rem; color: #475569; font-weight: 500; }
  .item-more { font-size: 0.75rem; color: #94a3b8; padding: 0.2rem; }

  .order-card-footer { margin-top: auto; padding-top: 1rem; border-top: 1px dashed #e2e8f0; display: flex; justify-content: space-between; align-items: center; color: #4f46e5; font-size: 0.875rem; font-weight: 600; }
  .order-card-footer .arrow { transition: transform 0.2s; }
  .order-card:hover .arrow { transform: translateX(4px); }

  .empty-state { text-align: center; padding: 5rem 2rem; background: white; border-radius: 24px; border: 1px solid #e2e8f0; }
  .empty-icon { font-size: 4rem; margin-bottom: 1.5rem; }
  .empty-state h2 { font-size: 1.5rem; margin-bottom: 0.5rem; }
  .empty-state p { color: #64748b; margin-bottom: 2rem; }
  .btn-primary { display: inline-block; background: #4f46e5; color: white; padding: 0.75rem 2rem; border-radius: 12px; text-decoration: none; font-weight: 700; transition: background 0.2s; }
  .btn-primary:hover { background: #4338ca; }

  .loading-state { text-align: center; padding: 5rem; }
  .spinner { width: 40px; height: 40px; border: 4px solid #f1f5f9; border-top-color: #4f46e5; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 1.5rem; }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
