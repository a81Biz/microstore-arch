{
  "name": "microstore-arch",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "docker compose up --build",
    "dev:stop": "docker compose down",
    "dev:reset": "docker compose down -v && docker compose up --build",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:core": "cd src/packages/core && npm run test",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:architecture": "bash src/scripts/check-architecture.sh",
    "prepare": "husky"
  },
  "workspaces": [
    "src/apps/*",
    "src/packages/*"
  ],
  "devDependencies": {
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "yaml": "^2.8.3",
    "yaml-language-server": "^1.23.0",
    "volar-service-yaml": "^0.0.71",
    "@vitest/mocker": "^3.2.4",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  }
}