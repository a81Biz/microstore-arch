    {
      "id": "concept_cascading_state_protocol",
      "label": "Cascading State Protocol (ACK-gated workflow)",
      "file_type": "rationale",
      "source_file": "docs/implementation/OPERATING_MODELS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Prevents AI from autonomously advancing phases without explicit user ACK. Ensures auditability and prevents runaway code generation. Each phase produces a single document artifact: SESSION_SUMMARY → PLAN_ACTUAL → PENDING_TASKS → HISTORY.log."
    },
    {
      "id": "concept_pgcrypto_schema_fix",
      "label": "pgcrypto extensions.* Schema Qualification Fix",
      "file_type": "rationale",
      "source_file": "supabase/migrations/00029_fix_crypto_schema.sql",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "PostgREST v12 sets search_path=public per transaction. SECURITY DEFINER functions without SET search_path inherit caller search_path. pgcrypto is installed in schema 'extensions', not 'public', so pgp_sym_encrypt/decrypt are unreachable at runtime via PostgREST. Fix: fully qualify all pgcrypto calls with extensions. prefix instead of altering search_path globally."
    },
    {
      "id": "concept_mfa_rls_claim",
      "label": "mfa_verified JWT Claim as RLS Gate",
      "file_type": "rationale",
      "source_file": "supabase/migrations/00015_storage_hardening.sql",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "app_metadata.mfa_verified:true is immutable by the user (only service_role can set it). RLS policies check this claim via auth.jwt()->'user_metadata'->>'mfa_verified' to enforce MFA for vendor write operations. This is the binding security contract between the auth layer and the data layer."
    },
    {
      "id": "concept_toggling_guard",
      "label": "_toggling Guard Pattern (Double-Fire Prevention)",
      "file_type": "rationale",
      "source_file": "apps/vendor-admin/src/pages/settings/index.astro",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Alpine.js x-for re-renders can cause @change inside <label> to fire twice due to synthetic click propagation. Adding a _toggling flag prevents duplicate POST requests when toggling a checkbox within a wrapping <label>."
    },
    {
      "id": "concept_auth_jwt_selfhosted",
      "label": "auth.jwt() Self-Hosted Polyfill",
      "file_type": "rationale",
      "source_file": "supabase/migrations/00000b_auth_helpers.sql",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Supabase Cloud auto-provisions auth.jwt(). The Docker self-hosted image supabase/postgres:15.8.1.032 does not include it. Migration 00000b defines it as CREATE OR REPLACE before any migration that references it, using lexicographic ordering (00000_ < 00000b_) to guarantee it runs first."
    },
    {
      "id": "concept_vendor_mfa_auth_flow",
      "label": "Vendor MFA First-Login Flow",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Enforces: login → forced password change (profiles.password_changed_at IS NULL) → TOTP setup (totp_enabled=false) → TOTP verify (mfa_verified claim). All three steps must complete before RLS unlocks vendor data access."
    },
    {
      "id": "concept_optimistic_toggle",
      "label": "Optimistic Toggle with Rollback Pattern",
      "file_type": "rationale",
      "source_file": "apps/vendor-admin/src/pages/products/index.astro",
      "source_location": "292-305",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "toggleVisibility applies isVisible=newState before the API call and rolls back on failure. Provides immediate UI feedback without waiting for the server round-trip. Applied in PT-FIX-018b / PT-FIX-020b to both products and settings pages."
    },
    {
      "id": "concept_trigger_rebuild",
      "label": "triggerRebuild After Mutations (SSG Invalidation)",
      "file_type": "rationale",
      "source_file": "apps/vendor-admin/src/pages/products/index.astro",
      "source_location": "282-283",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "After every product mutation (create, update, delete, toggleVisibility), triggerRebuild() is called to regenerate the storefront static pages, keeping the public catalog in sync with the DB."
    },
    {
      "id": "concept_snake_camel_mapping",
      "label": "snake_case to camelCase Field Mapping (mapProduct)",
      "file_type": "rationale",
      "source_file": "supabase/functions/manage-products/index.ts",
      "source_location": "32-45",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "mapProduct normalizes DB snake_case column names to camelCase for frontend consumers, keeping the API contract stable even if DB column names change. Added in PT-FIX-020a."
    },
    {
      "id": "concept_all_gateways_merge",
      "label": "ALL_GATEWAYS Constant + Map-Merge Pattern",
      "file_type": "rationale",
      "source_file": "supabase/functions/manage-payment-gateways/index.ts",
      "source_location": "49-69",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "listGateways always returns exactly 4 entries by merging DB data into ALL_GATEWAYS constant, ensuring disabled/unconfigured gateways appear with is_enabled:false rather than being omitted. Added in PT-FIX-021."
    },
    {
      "id": "concept_public_gateway_route",
      "label": "Public Gateway Route (no-auth checkout endpoint)",
      "file_type": "rationale",
      "source_file": "supabase/functions/manage-payment-gateways/index.ts",
      "source_location": "18-24",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "GET /manage-payment-gateways/public returns only enabled gateway names without credentials and without authentication, allowing the checkout UI to query available payment methods without exposing sensitive config."
    },
