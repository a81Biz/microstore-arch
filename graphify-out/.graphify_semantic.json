    {
      "id": "rationale_normalized_images_table",
      "label": "Normalized Table vs Array Column Rationale",
      "file_type": "rationale",
      "source_file": "docs/HANDOFF.md",
      "source_location": "§7 Decisiones de diseño",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Tabla normalizada product_images elegida sobre TEXT[] porque: sort_order y alt_text por imagen son inviables en array; DELETE directo por imagen requiere unnest; el JOIN es un SELECT simple con índice compuesto (product_id, sort_order)."
    },
    {
      "id": "rationale_image_url_primary_compat",
      "label": "products.image_url Primary Image Compatibility Rationale",
      "file_type": "rationale",
      "source_file": "docs/HANDOFF.md",
      "source_location": "§7 Decisiones de diseño",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "products.image_url se mantiene como imagen primaria (sort_order=0) para compatibilidad con ProductCard, cart-store y checkout — ninguno de esos componentes cambia."
    },
    {
      "id": "rationale_alpine_custom_events",
      "label": "Alpine Gallery Cross-Instance Sync via CustomEvents Rationale",
      "file_type": "rationale",
      "source_file": "docs/HANDOFF.md",
      "source_location": "§7 Decisiones de diseño",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "gallery-wrap y lightbox-overlay son dos nodos x-data=galleryStore() distintos; sincronizados via CustomEvent en document (gallery:open-lightbox, gallery:close, gallery:set-active) porque los dos nodos no comparten scope Alpine."
    },
    {
      "id": "rationale_storage_timestamp_filename",
      "label": "Storage Filename Timestamp Strategy Rationale",
      "file_type": "rationale",
      "source_file": "docs/HANDOFF.md",
      "source_location": "§7 Decisiones de diseño",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "uploadProductImage usa Date.now().ext en lugar de main.ext para soportar múltiples archivos por producto en el mismo bucket sin sobreescritura."
    }
