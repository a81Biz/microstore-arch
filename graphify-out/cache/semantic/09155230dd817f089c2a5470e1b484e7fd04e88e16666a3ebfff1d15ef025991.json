{"nodes": [{"id": "migration_00029_fix_crypto", "label": "Migration 00029: Fix pgcrypto Schema Qualification", "file_type": "code", "source_file": "supabase/migrations/00029_fix_crypto_schema.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_pgcrypto_schema_fix", "label": "pgcrypto extensions.* Schema Qualification Fix", "file_type": "rationale", "source_file": "supabase/migrations/00029_fix_crypto_schema.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgREST v12 sets search_path=public per transaction. SECURITY DEFINER functions without SET search_path inherit caller search_path. pgcrypto is installed in schema 'extensions', not 'public', so pgp_sym_encrypt/decrypt are unreachable at runtime via PostgREST. Fix: fully qualify all pgcrypto calls with extensions. prefix instead of altering search_path globally."}, {"id": "fn_save_payment_credentials", "label": "save_payment_credentials (PL/pgSQL)", "file_type": "code", "source_file": "supabase/migrations/00029_fix_crypto_schema.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fn_get_payment_credentials", "label": "get_payment_credentials (PL/pgSQL)", "file_type": "code", "source_file": "supabase/migrations/00029_fix_crypto_schema.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "fn_save_payment_credentials", "target": "payment_credentials_table", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/migrations/00029_fix_crypto_schema.sql", "source_location": "29-37", "weight": 1.0}, {"source": "fn_get_payment_credentials", "target": "payment_credentials_table", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supa