---
import VendorAdminLayout from '../../layouts/VendorAdminLayout.astro';
---

<VendorAdminLayout title="Configuración de Pagos">
  <div class="settings-page" x-data="paymentSettings()" x-init="loadGateways()">
    <header class="settings-header">
      <div class="header-content">
        <h1>Métodos de Pago</h1>
        <p>Configura y activa las pasarelas para tus clientes</p>
      </div>
    </header>

    <template x-if="authError">
      <div class="alert alert-danger" x-text="authError"></div>
    </template>

    <template x-if="loading">
      <div class="loading-state">
        <div class="spinner"></div>
        <p>Cargando configuración de pasarelas...</p>
      </div>
    </template>

    <template x-if="!loading && !authError">
      <div class="gateways-list">
        <template x-for="gateway in gateways" :key="gateway.gateway">
          <div class="gateway-card" :class="{ active: gateway.is_enabled }">
            <div class="gateway-main">
              <div class="gateway-info">
                <div class="gateway-icon" x-text="getGatewayIcon(gateway.gateway)"></div>
                <div>
                  <h2 x-text="getGatewayName(gateway.gateway)"></h2>
                  <span class="status-badge" :class="gateway.is_enabled ? 'status-on' : 'status-off'"
                        x-text="gateway.is_enabled ? 'Activo' : 'Inactivo'"></span>
                  <template x-if="gateway.created_at">
                    <span class="configured-badge">Configurado ✓</span>
                  </template>
                </div>
              </div>

              <div class="gateway-actions">
                <button @click="toggleForm(gateway.gateway)" class="btn-secondary" x-text="showForm === gateway.gateway ? 'Cerrar' : (gateway.created_at ? 'Actualizar' : 'Configurar')"></button>
                <label class="switch">
                  <input type="checkbox" :checked="gateway.is_enabled" @change="toggleGateway(gateway)" />
                  <span class="slider"></span>
                </label>
              </div>
            </div>

            <!-- Formulario de Credenciales -->
            <template x-if="showForm === gateway.gateway">
              <div class="credentials-container" x-transition>
                <form @submit.prevent="saveCredentials(gateway.gateway)" class="credentials-form">
                  <template x-if="gateway.created_at">
                    <div class="info-banner">
                      <strong>Credenciales guardadas.</strong>
                      Ingresa nuevas credenciales para reemplazarlas. Si solo deseas cambiar el estado activo/inactivo, guarda con los campos vacíos.
                    </div>
                  </template>
                  <div class="form-grid">
                    <template x-if="gateway.gateway === 'stripe'">
                      <div class="form-contents">
                        <div class="form-group">
                          <label>Publishable Key</label>
                          <input type="password" x-model="credentials.stripe.publishableKey" placeholder="pk_live_..." autocomplete="off" />
                        </div>
                        <div class="form-group">
                          <label>Secret Key</label>
                          <input type="password" x-model="credentials.stripe.secretKey" placeholder="sk_live_..." autocomplete="off" />
                        </div>
                        <div class="form-group">
                          <label>Webhook Secret</label>
                          <input type="password" x-model="credentials.stripe.webhookSecret" placeholder="whsec_..." autocomplete="off" />
                        </div>
                      </div>
                    </template>

                    <template x-if="gateway.gateway === 'paypal'">
                      <div class="form-contents">
                        <div class="form-group">
                          <label>Client ID</label>
                          <input type="password" x-model="credentials.paypal.clientId" autocomplete="off" />
                        </div>
                        <div class="form-group">
                          <label>Secret</label>
                          <input type="password" x-model="credentials.paypal.secret" autocomplete="off" />
                        </div>
                      </div>
                    </template>

                    <template x-if="gateway.gateway === 'mercadopago'">
                      <div class="form-contents">
                        <div class="form-group">
                          <label>Access Token</label>
                          <input type="password" x-model="credentials.mercadopago.accessToken" placeholder="APP_USR-..." autocomplete="off" />
                        </div>
                      </div>
                    </template>

                    <template x-if="gateway.gateway === 'hey_banco'">
                      <div class="form-contents">
                        <div class="form-group">
                          <label>API Key (Opcional)</label>
                          <input type="password" x-model="credentials.hey_banco.apiKey" autocomplete="off" />
                        </div>
                        <div class="form-group">
                          <label>Número de CLABE (18 dígitos)</label>
                          <input type="text" x-model="credentials.hey_banco.clabe"
                                 placeholder="Ej: 021180040800000001"
                                 pattern="\d{18}" title="La CLABE debe tener exactamente 18 dígitos"
                                 maxlength="18" inputmode="numeric" />
                        </div>
                      </div>
                    </template>
                  </div>

                  <template x-if="saveMessage[gateway.gateway]">
                    <div class="alert alert-success" x-text="saveMessage[gateway.gateway]"></div>
                  </template>
                  <template x-if="saveError[gateway.gateway]">
                    <div class="alert alert-danger" x-text="saveError[gateway.gateway]"></div>
                  </template>

                  <div class="form-footer">
                    <p class="security-note">🔒 Tus credenciales se encriptan antes de guardarse.</p>
                    <button type="submit" class="btn-primary" :disabled="savingGateway === gateway.gateway">
                      <span x-show="savingGateway !== gateway.gateway">Guardar Cambios</span>
                      <span x-show="savingGateway === gateway.gateway">Guardando...</span>
                    </button>
                  </div>
                </form>
              </div>
            </template>
          </div>
        </template>
      </div>
    </template>
  </div>
    <!-- Sección de Configuración de Email (solo lectura SSR — no expone secretos al cliente) -->
    <div class="email-config-section">
      <h2>Configuración de Email</h2>
      <p class="email-config-desc">Los emails transaccionales (pedido, envío, entrega) se envían vía Resend. Configura las variables en tu archivo <code>.env</code>.</p>
      <div class="email-status-grid">
        <div class="email-status-item">
          <span class="status-label">RESEND_API_KEY</span>
          {import.meta.env.RESEND_API_KEY
            ? <span class="status-badge status-on">Configurada ✓</span>
            : <span class="status-badge status-off">No configurada ✗</span>
          }
        </div>
        <div class="email-status-item">
          <span class="status-label">EMAIL_FROM</span>
          {import.meta.env.EMAIL_FROM
            ? <span class="status-badge status-on">{import.meta.env.EMAIL_FROM}</span>
            : <span class="status-badge status-off">No configurada ✗</span>
          }
        </div>
      </div>
      <div class="email-links">
        <a href="http://localhost:8025" target="_blank" rel="noopener" class="email-link">Inbucket (emails locales) →</a>
        <a href="https://resend.com/api-keys" target="_blank" rel="noopener" class="email-link">Obtener API key en Resend →</a>
      </div>
    </div>
</VendorAdminLayout>

<script>
  import { getVendorAuthHeader } from '../../lib/auth/auth-client';
  import { API_ROUTES } from '@micro-store/core';

  window.paymentSettings = () => ({
    gateways: [],
    loading: true,
    authError: '',
    showForm: null,
    savingGateway: null,
    saveMessage: {},
    saveError: {},
    credentials: {
      stripe: { publishableKey: '', secretKey: '', webhookSecret: '' },
      paypal: { clientId: '', secret: '' },
      mercadopago: { accessToken: '' },
      hey_banco: { apiKey: '', clabe: '' }
    },

    async loadGateways() {
      this.loading = true;
      this.authError = '';
      try {
        const authHeader = await getVendorAuthHeader();
        if (!authHeader) {
          this.authError = 'Sesión expirada. Por favor inicia sesión nuevamente.';
          return;
        }
        const response = await fetch(`${import.meta.env.PUBLIC_API_BASE}${API_ROUTES.admin.paymentGateways}`, {
          headers: { 'Authorization': authHeader }
        });

        if (response.status === 401) {
          this.authError = 'No tienes permiso para ver esta página.';
          return;
        }

        if (response.ok) {
          const data = await response.json();
          this.gateways = Array.isArray(data) && data.length > 0
            ? data
            : [
                { gateway: 'stripe', is_enabled: false },
                { gateway: 'paypal', is_enabled: false },
                { gateway: 'mercadopago', is_enabled: false },
                { gateway: 'hey_banco', is_enabled: false }
              ];
        }
      } catch {
        this.authError = 'Error de red al cargar pasarelas. Verifica tu conexión.';
      } finally {
        this.loading = false;
      }
    },

    getGatewayName(gateway) {
      const names: Record<string, string> = { stripe: 'Stripe (Tarjetas)', paypal: 'PayPal', mercadopago: 'Mercado Pago', hey_banco: 'Hey Banco' };
      return names[gateway] || gateway;
    },

    getGatewayIcon(gateway) {
      const icons: Record<string, string> = { stripe: '💳', paypal: '🅿️', mercadopago: '🤝', hey_banco: '🏦' };
      return icons[gateway] || '💰';
    },

    toggleForm(gateway) {
      this.showForm = this.showForm === gateway ? null : gateway;
      this.saveMessage[gateway] = '';
      this.saveError[gateway] = '';
    },

    async toggleGateway(gateway) {
      if (gateway._toggling) return;
      gateway._toggling = true;
      const newState = !gateway.is_enabled;
      try {
        const authHeader = await getVendorAuthHeader();
        const response = await fetch(`${import.meta.env.PUBLIC_API_BASE}${API_ROUTES.admin.paymentGateways}`, {
          method: 'POST',
          headers: {
            'Authorization': authHeader,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            gateway: gateway.gateway,
            is_enabled: newState,
            credentials: {}
          })
        });

        if (!response.ok) {
          const data = await response.json();
          this.saveError[gateway.gateway] = data.message || 'Error al cambiar estado del gateway';
          return;
        }

        gateway.is_enabled = newState;
      } catch {
        this.saveError[gateway.gateway] = 'Error de red al conectar con la API';
      } finally {
        setTimeout(() => { gateway._toggling = false; }, 200);
      }
    },

    async saveCredentials(gateway) {
      this.savingGateway = gateway;
      this.saveMessage[gateway] = '';
      this.saveError[gateway] = '';

      try {
        const authHeader = await getVendorAuthHeader();
        const gw = this.gateways.find(g => g.gateway === gateway);
        const response = await fetch(`${import.meta.env.PUBLIC_API_BASE}${API_ROUTES.admin.paymentGateways}`, {
          method: 'POST',
          headers: {
            'Authorization': authHeader,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            gateway,
            is_enabled: gw?.is_enabled ?? false,
            credentials: (this.credentials as unknown as Record<string, unknown>)[gateway]
          })
        });

        if (response.ok) {
          this.saveMessage[gateway] = 'Configuración guardada exitosamente';
          // Limpiar campos sensibles después de guardar
          const creds = (this.credentials as unknown as Record<string, Record<string, string>>)[gateway];
          if (creds) Object.keys(creds).forEach(k => { creds[k] = ''; });
          setTimeout(() => { this.showForm = null; }, 2000);
        } else {
          const data = await response.json();
          this.saveError[gateway] = data.message || 'Error al guardar';
        }
      } catch {
        this.saveError[gateway] = 'Error de red al conectar con la API';
      } finally {
        this.savingGateway = null;
      }
    }
  });
</script>

<style>
  .settings-page { padding: 3rem; max-width: 900px; margin: 0 auto; }
  .settings-header { margin-bottom: 3rem; }
  .settings-header h1 { font-size: 2.25rem; font-weight: 800; color: #111827; margin-bottom: 0.5rem; }
  .settings-header p { color: #6b7280; font-size: 1.1rem; }

  .gateways-list { display: flex; flex-direction: column; gap: 1.5rem; }
  .gateway-card { background: white; border-radius: 20px; border: 1px solid #e5e7eb; overflow: hidden; transition: all 0.3s; }
  .gateway-card.active { border-color: #16213e; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); }

  .gateway-main { padding: 1.5rem 2rem; display: flex; justify-content: space-between; align-items: center; }
  .gateway-info { display: flex; align-items: center; gap: 1.5rem; }
  .gateway-icon { font-size: 2rem; width: 48px; height: 48px; background: #f3f4f6; border-radius: 12px; display: flex; align-items: center; justify-content: center; }
  .gateway-info h2 { font-size: 1.25rem; font-weight: 700; color: #111827; margin-bottom: 0.25rem; }

  .status-badge { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; padding: 0.2rem 0.6rem; border-radius: 6px; }
  .status-on { background: #ecfdf5; color: #065f46; }
  .status-off { background: #f3f4f6; color: #6b7280; }
  .configured-badge {
    font-size: 0.7rem; font-weight: 700; padding: 0.2rem 0.6rem;
    border-radius: 6px; background: #eff6ff; color: #1e40af;
  }
  .info-banner {
    background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe;
    border-radius: 10px; padding: 0.875rem 1rem;
    font-size: 0.875rem; margin-bottom: 1rem;
  }

  .gateway-actions { display: flex; align-items: center; gap: 1.5rem; }

  .switch { position: relative; display: inline-block; width: 44px; height: 24px; }
  .switch input { opacity: 0; width: 0; height: 0; }
  .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #e5e7eb; transition: .4s; border-radius: 24px; }
  .slider:before { position: absolute; content: ""; height: 18px; width: 18px; left: 3px; bottom: 3px; background-color: white; transition: .4s; border-radius: 50%; }
  input:checked + .slider { background-color: #16213e; }
  input:checked + .slider:before { transform: translateX(20px); }

  .credentials-container { background: #f9fafb; border-top: 1px solid #e5e7eb; padding: 2rem; }
  .credentials-form { display: flex; flex-direction: column; gap: 1.5rem; }
  .form-contents { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.5rem; }
  .form-group label { font-size: 0.875rem; font-weight: 600; color: #374151; }
  .form-group input { padding: 0.75rem 1rem; border: 1px solid #d1d5db; border-radius: 10px; font-family: monospace; font-size: 0.95rem; }
  .form-group input:focus { border-color: #16213e; outline: none; }

  .form-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 1rem; }
  .security-note { font-size: 0.8rem; color: #6b7280; font-style: italic; }

  .btn-primary { background: #16213e; color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 10px; font-weight: 700; cursor: pointer; }
  .btn-secondary { background: white; border: 1px solid #d1d5db; color: #374151; padding: 0.5rem 1rem; border-radius: 8px; font-weight: 600; cursor: pointer; }
  .btn-secondary:hover { background: #f9fafb; }

  .alert { padding: 1rem; border-radius: 10px; font-size: 0.9rem; font-weight: 500; }
  .alert-success { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
  .alert-danger { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }

  .loading-state { text-align: center; padding: 5rem; color: #6b7280; }
  .spinner { width: 40px; height: 40px; border: 4px solid #f3f4f6; border-top: 4px solid #16213e; border-radius: 50%; margin: 0 auto 1rem; animation: spin 1s linear infinite; }
  @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

  .email-config-section { margin-top: 3rem; background: white; border-radius: 20px; border: 1px solid #e5e7eb; padding: 2rem; }
  .email-config-section h2 { font-size: 1.25rem; font-weight: 700; color: #111827; margin-bottom: 0.5rem; }
  .email-config-desc { color: #6b7280; font-size: 0.9rem; margin-bottom: 1.5rem; }
  .email-config-desc code { background: #f3f4f6; padding: 0.1rem 0.4rem; border-radius: 4px; font-family: monospace; }
  .email-status-grid { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem; }
  .email-status-item { display: flex; align-items: center; gap: 1rem; }
  .status-label { font-size: 0.875rem; font-weight: 600; color: #374151; min-width: 160px; font-family: monospace; }
  .email-links { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .email-link { font-size: 0.875rem; color: #16213e; font-weight: 600; text-decoration: none; }
  .email-link:hover { text-decoration: underline; }
</style>
